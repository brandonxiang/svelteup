{
  "name": "svelteup",
  "version": "5.2.1",
  "description": "Bundle Svelte components as web components with Rolldown.",
  "keywords": [
    "rolldown",
    "svelte",
    "web component"
  ],
  "homepage": "https://github.com/brandonxiang/svelteup#readme",
  "bugs": {
    "url": "https://github.com/brandonxiang/svelteup/issues"
  },
  "license": "MIT",
  "author": "brandonxiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonxiang/svelteup.git"
  },
  "bin": {
    "svelteup": "bin.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "bin.js",
    "templates"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "tsdown src/index.ts --format esm,cjs",
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "lint": "oxlint .",
    "test": "pnpm run build && vitest run && vitest --config vitest.browser.config.mts run",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "lodash.merge": "^4.6.2",
    "rolldown": "^1.0.2",
    "sade": "^1.8.1",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^25.9.1",
    "@vitest/browser-playwright": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "release-it": "^20.0.1",
    "svelte": "^5.55.9",
    "svelte-preprocess": "^6.0.4",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vitest-browser-svelte": "^2.1.1"
  },
  "packageManager": "pnpm@11.2.2",
  "createConfig": {
    "templates": [
      {
        "name": "svelteup-starter",
        "description": "A minimal Svelteup starter for browser embeds.",
        "template": "./templates/svelteup-starter"
      },
      {
        "name": "svelteup-revealjs",
        "description": "A Reveal.js presentation starter with Svelte custom elements.",
        "template": "./templates/svelteup-revealjs"
      },
      {
        "name": "svelteup-chrome-extension",
        "description": "A Chrome extension starter powered by Svelteup.",
        "template": "./templates/svelteup-chrome-extension"
      }
    ]
  }
}
